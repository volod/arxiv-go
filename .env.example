# Optional arxgo settings. Copy this file to .env beside arxgo (make setup creates bin/.env).
# Uncomment only the settings you need. All lines below are examples; defaults apply otherwise.
# A command-line flag wins over a process ARXGO_* variable, which wins over this file.
# Empty values act as unset. Paths are relative to the working directory, not to this file.
# Syntax: KEY=value, # comments, optional export prefix, ${KEY} for an earlier value.
# On Windows, use unquoted or single-quoted paths: double quotes consume backslashes.
# Keep a real .env private; it may eventually hold publishing credentials.

# --- Archive locations (scan, split, restore) ---
# Main archive root. Set this here or pass --archive on every command.
# ARXGO_ARCHIVE=/data/archive
# ARXGO_ARCHIVE='D:\archive'
# Separate video archive root; needed by split and restore, ignored by scan.
# Roots may be on different devices, but neither may contain the other.
# ARXGO_VIDEO_ARCHIVE=/mnt/video
# ARXGO_VIDEO_ARCHIVE='\\nas\video'

# --- Run safety and progress (all commands) ---
# true: scan and estimate work, then report the plan without moving videos or writing
# registries, descriptions or previews. A run directory/log/report under <archive>/.arxgo may be written.
# ARXGO_DRY_RUN=false
# Keep at least this much free on each device arxgo writes to, in addition to its estimated needs.
# 1GiB is 1,073,741,824 bytes. If space is too low, exit 4 before moving files.
# ARXGO_MIN_FREE=1GiB
# Recover an incomplete previous run first, then start a fresh scan instead of resuming it.
# ARXGO_NEW_RUN=false
# Take over only a stale local lock; never use for a live or remote-host run.
# ARXGO_FORCE_UNLOCK=false
# Console logging: debug | info | warn | error; text | json.
# ARXGO_LOG_LEVEL=info
# ARXGO_LOG_FORMAT=text
# Minimum time between progress lines. Durations use 10s, 5m or 1h30m syntax.
# ARXGO_PROGRESS_INTERVAL=10s
# Checkpoint after this many scanned entries or this much time, whichever comes first.
# More frequent checkpoints improve resume granularity but add disk writes.
# ARXGO_CHECKPOINT_EVERY=500
# ARXGO_CHECKPOINT_INTERVAL=30s

# --- File catalog and video selection (scan and split) ---
# Mark files at least this large in the CSV. Sizes accept KB/MB/GB (decimal) or
# KiB/MiB/GiB (binary); a bare number is bytes.
# ARXGO_LARGE_THRESHOLD=1GiB
# CSV location; default is <archive>/arxgo-registry.csv.
# ARXGO_REGISTRY=/data/archive/arxgo-registry.csv
# file: filesystem metadata plus ISO BMFF fields for MP4/MOV/M4A/M4V/3GP, no
# external tool. media: also ffprobe for other audio/video and ISO failures;
# requires ffprobe even if the archive contains only MP4 files.
# ARXGO_METADATA=file
# Exclude relative paths from the scan, including their subtrees. Separate multiple
# globs with ':' on Linux or ';' on Windows; use '/' within patterns on both systems.
# ARXGO_EXCLUDE=*.tmp:cache/**
# ARXGO_EXCLUDE=*.tmp;cache/**
# Extra comma-separated extensions used as video only when file signatures are inconclusive.
# ARXGO_VIDEO_EXTENSIONS=braw,r3d
# Symlinks are recorded but never followed. There is no enabled true setting for this flag;
# leave it unset. Setting true is rejected by current builds.
# ARXGO_FOLLOW_SYMLINKS=false

# --- Video transfer (split and restore) ---
# auto: rename on the same device, copy across devices. copy: force a copy path.
# On split, copy removes the source after verification and durable description creation.
# On restore, copy keeps the video-archive source as a second copy.
# ARXGO_TRANSFER=auto
# size: compare byte counts; hash: verify SHA-256 after copying (more I/O).
# ARXGO_VERIFY=size

# --- Split: links and previews ---
# Optional URL where you will separately publish the video archive. arxgo does not upload it.
# A description link is this URL plus the video's escaped relative path. Omit until that URL works.
# ARXGO_BASE_URL=https://storage.example.com/video
# Samples: none | start | middle | end | series. Frames use the same modes independently.
# Any active mode needs ffmpeg and ffprobe; previews are written beside descriptions in the main archive.
# ARXGO_SAMPLE=none
# Clip length; with series, length of each fragment.
# ARXGO_SAMPLE_DURATION=5s
# Spacing between series fragments.
# ARXGO_SAMPLE_EVERY=5m
# Upper size bound: sd (640x360) | hd (1920x1080) | 4k (3840x2160).
# ARXGO_SAMPLE_RESOLUTION=sd
# low | medium | high; higher quality uses more space.
# ARXGO_SAMPLE_QUALITY=medium
# none | start | middle | end | series; PNG frames, independent of sample clips.
# ARXGO_IMAGE=none
# Spacing between series frames.
# ARXGO_IMAGE_EVERY=5m
# sd | hd | 4k upper size bound.
# ARXGO_IMAGE_RESOLUTION=sd
# low | medium | high; controls PNG compression (not image detail).
# ARXGO_IMAGE_QUALITY=medium
# Maximum number of fragments or frames in each series.
# ARXGO_PREVIEW_MAX_ITEMS=100

# --- Restore: destination and cleanup ---
# delete | keep: remove only an arxgo-owned video description, or leave it beside the video.
# ARXGO_DESCRIPTIONS=delete
# keep | delete: retain previews, or remove recorded previews whose sizes still match.
# ARXGO_PREVIEWS=keep
# Recreate missing parent directories; otherwise those videos are skipped.
# ARXGO_CREATE_DIRS=false
# Replace a different existing destination file; otherwise report a conflict and skip it.
# ARXGO_OVERWRITE=false
# Mark restored rows in the video registries and regenerate summaries.
# ARXGO_REGISTRY_UPDATE=true

# --- Future cloud publishing (not available in current builds) ---
# Leave these unset. Current builds reject their use; they do not upload or share files.
# ARXGO_PUBLISH=
# ARXGO_PUBLISH_DELETE_LOCAL=false
# ARXGO_GDRIVE_DRIVE_ID=
# ARXGO_GDRIVE_CREDENTIALS=
# ARXGO_SHARE=none
