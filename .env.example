# arxgo environment file template.
#
# `make setup` copies this file to bin/.env next to the arxgo binary. arxgo reads the .env file in
# the directory of its executable. The file is optional: flags or process environment variables
# can supply every value instead.
#
# Precedence, highest first: command-line flag, process environment, this file, built-in default.
# Every flag --some-name maps to ARXGO_SOME_NAME. Uncomment a line to set a value. An empty value
# counts as unset.
#
# Syntax: KEY=value, # comments, optional `export ` prefix, ${KEY} expands a key defined earlier
# in this file. Quote Windows paths with single quotes or leave them unquoted: double quotes
# treat backslashes as escapes ("C:\data" becomes "C:data").
# Relative paths are resolved against the current working directory, not this file.
#
# The file may hold credentials. Keep it out of version control (it is git-ignored) and readable
# only by its owner.

# --- Common (all operations) -------------------------------------------------------------------
# Root of the main archive (required).
# ARXGO_ARCHIVE=/data/archive
# ARXGO_ARCHIVE='D:\archive'
# Root of the video archive (required for split and restore; ignored by scan).
# ARXGO_VIDEO_ARCHIVE=/mnt/nas/video
# ARXGO_VIDEO_ARCHIVE='\\nas\video'
# debug | info | warn | error
# ARXGO_LOG_LEVEL=info
# text | json
# ARXGO_LOG_FORMAT=text
# ARXGO_PROGRESS_INTERVAL=10s
# ARXGO_CHECKPOINT_EVERY=500
# ARXGO_CHECKPOINT_INTERVAL=30s
# ARXGO_DRY_RUN=false
# Sizes: B, KB, MB, GB, TB (powers of 1000) or KiB, MiB, GiB, TiB (powers of 1024).
# ARXGO_MIN_FREE=1GiB
# ARXGO_NEW_RUN=false
# ARXGO_FORCE_UNLOCK=false

# --- Scan (scan, and split for its scan phase) ------------------------------------------------
# ARXGO_LARGE_THRESHOLD=1GiB
# Default: <archive>/arxgo-registry.csv
# ARXGO_REGISTRY=
# file | media (media needs ffprobe for non-MP4 containers)
# ARXGO_METADATA=file
# Globs separated by ':' on Linux or ';' on Windows; use '/' inside patterns on every platform.
# ARXGO_EXCLUDE=*.tmp:cache/**
# Reserved in stage 1; only false is accepted.
# ARXGO_FOLLOW_SYMLINKS=false

# --- Split and restore ------------------------------------------------------------------------
# auto | copy
# ARXGO_TRANSFER=auto
# size | hash
# ARXGO_VERIFY=size

# --- Split ------------------------------------------------------------------------------------
# Absolute http(s) URL without credentials, query or fragment; stubs link to URL/<rel_path>.
# ARXGO_BASE_URL=https://storage.example.com/video
# ARXGO_VIDEO_EXTENSIONS=mts,m2ts

# --- Restore ----------------------------------------------------------------------------------
# delete | keep
# ARXGO_STUBS=delete
# ARXGO_CREATE_DIRS=false
# ARXGO_OVERWRITE=false
# ARXGO_REGISTRY_UPDATE=true

# --- Stage 2 previews (not available in this build; setting them exits 2) ---------------------
# ARXGO_SAMPLE=none
# ARXGO_SAMPLE_DURATION=5s
# ARXGO_SAMPLE_EVERY=5m
# ARXGO_SAMPLE_RESOLUTION=sd
# ARXGO_SAMPLE_QUALITY=medium
# ARXGO_IMAGE=none
# ARXGO_IMAGE_EVERY=5m
# ARXGO_IMAGE_RESOLUTION=sd
# ARXGO_IMAGE_QUALITY=medium
# ARXGO_PREVIEW_MAX_ITEMS=100
# Restore only.
# ARXGO_PREVIEWS=keep

# --- Stage 3 cloud publishing (not available in this build; setting them exits 2) --------------
# ARXGO_PUBLISH=
# ARXGO_PUBLISH_DELETE_LOCAL=false
# ARXGO_GDRIVE_DRIVE_ID=
# ARXGO_GDRIVE_CREDENTIALS=
# ARXGO_SHARE=none
# Credential variables for Google Drive and SharePoint (secrets such as client secrets) will be
# added here by the cloud-publishing tasks. Never pass secrets as flag values.
